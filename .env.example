# Vercel Marketplace > Upstash Redis integration injects these automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Legacy Vercel KV integrations use these names instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Kakao Developers > App keys > REST API key
KAKAO_REST_API_KEY=
# Optional when client secret is enabled in Kakao Developers
KAKAO_CLIENT_SECRET=
# Example: https://your-project.vercel.app/api/auth/kakao/callback
KAKAO_REDIRECT_URI=
